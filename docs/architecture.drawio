<mxfile pages="1"><diagram id="sharding-page" name="Sharded cluster"><mxGraphModel grid="0" page="1" background="#ffffff"><root><mxCell id="sharding-0" /><mxCell id="sharding-bg" parent="sharding-0" value="background" /><mxCell id="sharding-bgr" parent="sharding-bg" style="whiteSpace=wrap;html=1;strokeColor=none;" value="" vertex="1"><mxGeometry width="2280" height="880" as="geometry" /></mxCell><mxCell id="sharding-common" parent="sharding-0" value="sharding-common" /><mxCell id="sharding-flow" parent="sharding-0" value="sharding-flow" /><mxCell id="sharding-init" parent="sharding-0" value="sharding-init" /><mxCell id="sharding-1" parent="sharding-common" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_corporate_data_center;strokeColor=#2496ED;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#2496ED;labelBackgroundColor=none;fontFamily=Verdana;dashed=0;" value="Docker Compose · proyecto &lt;b&gt;mongodb-sharding&lt;/b&gt; · red interna (cada servicio se resuelve por su nombre)" vertex="1"><mxGeometry x="160" y="40" width="1340" height="820" as="geometry" /></mxCell><mxCell id="sharding-2" parent="sharding-common" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;fontFamily=Verdana;" value="Desarrollador" vertex="1"><mxGeometry x="40" y="331" width="60" height="60" as="geometry" /></mxCell><mxCell id="sharding-3" parent="sharding-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="110" y="301" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-4" parent="sharding-common" style="shape=mxgraph.veeam2.laptop;html=1;fillColor=#CCCCCC;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=12;" value="Host&lt;br&gt;(Compass / mongosh)&lt;br&gt;localhost:27017" vertex="1"><mxGeometry x="30" y="560" width="100" height="60" as="geometry" /></mxCell><mxCell id="sharding-5" parent="sharding-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;" vertex="1"><mxGeometry x="140" y="530" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-6" parent="sharding-common" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C86;dashed=1;verticalAlign=top;fontColor=#5A6C86;fontFamily=Verdana;fontSize=12;" value="Container &lt;b&gt;MongoShardingLab&lt;/b&gt;&lt;br&gt;Python 3.13 · pymongo · mongosh" vertex="1"><mxGeometry x="190" y="250" width="240" height="200" as="geometry" /></mxCell><mxCell id="sharding-7" parent="sharding-common" style="sketch=0;html=1;dashed=0;whitespace=wrap;fillColor=#434445;strokeColor=none;shape=mxgraph.vvd.web_browser;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;" value="lessons/*.py" vertex="1"><mxGeometry x="270" y="331" width="80" height="60" as="geometry" /></mxCell><mxCell id="sharding-8" parent="sharding-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;" vertex="1"><mxGeometry x="350" y="301" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-9" parent="sharding-common" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;fontFamily=Verdana;verticalLabelPosition=top;verticalAlign=bottom;" value="&lt;b&gt;mongos&lt;/b&gt; · MongoRouter&lt;br&gt;router · :27017" vertex="1"><mxGeometry x="540" y="322" width="78" height="78" as="geometry" /></mxCell><mxCell id="sharding-10" parent="sharding-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;" vertex="1"><mxGeometry x="628" y="392" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-11" parent="sharding-common" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=default;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;labelBackgroundColor=none;fontFamily=Verdana;dashed=1;dashPattern=8 8;" value="Config server · replica set &lt;b&gt;configrs&lt;/b&gt; (1 nodo)" vertex="1"><mxGeometry x="740" y="80" width="500" height="190" as="geometry" /></mxCell><mxCell id="sharding-12" parent="sharding-common" style="shape=mxgraph.webicons.mongodb;gradientColor=#DFDEDE;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;aspect=fixed;strokeColor=none;" value="&lt;b&gt;configsvr&lt;/b&gt; · MongoConfig&lt;br&gt;mongod --configsvr · :27019" vertex="1"><mxGeometry x="800" y="140" width="66" height="62" as="geometry" /></mxCell><mxCell id="sharding-13" parent="sharding-common" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Verdana;fontSize=11;rounded=1;fillColor=#F5F5F5;strokeColor=#DDDDDD;spacing=8;arcSize=6;" value="&lt;b&gt;Metadatos&lt;/b&gt;: shards, bases y su primary shard, colecciones con su shard key y los &lt;b&gt;chunks&lt;/b&gt; (rango → shard). Aquí corre el &lt;b&gt;balancer&lt;/b&gt;." vertex="1"><mxGeometry x="980" y="125" width="240" height="90" as="geometry" /></mxCell><mxCell id="sharding-14" parent="sharding-common" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;" vertex="1"><mxGeometry x="1190" y="45" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-15" parent="sharding-common" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=default;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;labelBackgroundColor=none;fontFamily=Verdana;dashed=1;dashPattern=8 8;" value="Shard &lt;b&gt;shard1rs&lt;/b&gt; (1 nodo) · primary shard de &lt;i&gt;shop&lt;/i&gt;" vertex="1"><mxGeometry x="740" y="310" width="500" height="190" as="geometry" /></mxCell><mxCell id="sharding-16" parent="sharding-common" style="shape=mxgraph.webicons.mongodb;gradientColor=#DFDEDE;html=1;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;aspect=fixed;strokeColor=none;" value="&lt;b&gt;shard1&lt;/b&gt; · MongoShard1&lt;br&gt;mongod --shardsvr · :27018" vertex="1"><mxGeometry x="800" y="330" width="66" height="62" as="geometry" /></mxCell><mxCell id="sharding-17" parent="sharding-common" style="text;html=1;whiteSpac