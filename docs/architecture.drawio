try relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="341.5" /><mxPoint x="670" y="171" /></Array></mxGeometry></mxCell><mxCell id="sharding-27" edge="1" parent="sharding-flow" source="sharding-9" target="sharding-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sharding-28" edge="1" parent="sharding-flow" source="sharding-9" target="sharding-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="380.5" /><mxPoint x="700" y="631" /></Array></mxGeometry></mxCell><mxCell id="sharding-29" edge="1" parent="sharding-flow" source="sharding-15" target="sharding-19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;startArrow=classic;startFill=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sharding-30" edge="1" parent="sharding-flow" source="sharding-11" target="sharding-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="sharding-31" parent="sharding-init" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5A6C86;dashed=1;verticalAlign=top;fontColor=#5A6C86;fontFamily=Verdana;fontSize=12;" value="Container &lt;b&gt;MongoShardingInit&lt;/b&gt;&lt;br&gt;(se ejecuta una vez)" vertex="1"><mxGeometry x="1290" y="330" width="190" height="150" as="geometry" /></mxCell><mxCell id="sharding-32" parent="sharding-init" style="sketch=0;html=1;fillColor=#232F3D;strokeColor=none;shape=mxgraph.aws4.gear;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;align=center;fontFamily=Verdana;fontSize=11;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" value="init.sh" vertex="1"><mxGeometry x="1361" y="390" width="47" height="47" as="geometry" /></mxCell><mxCell id="sharding-33" parent="sharding-init" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt;" vertex="1"><mxGeometry x="1460" y="300" width="48" height="52" as="geometry" /></mxCell><mxCell id="sharding-34" edge="1" parent="sharding-init" source="sharding-32" target="sharding-11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="413.5" /><mxPoint x="1265" y="175" /></Array></mxGeometry></mxCell><mxCell id="sharding-35" edge="1" parent="sharding-init" source="sharding-32" target="sharding-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="413.5" /><mxPoint x="1265" y="405" /></Array></mxGeometry></mxCell><mxCell id="sharding-36" edge="1" parent="sharding-init" source="sharding-32" target="sharding-19" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1265" y="413.5" /><mxPoint x="1265" y="635" /></Array></mxGeometry></mxCell><mxCell id="sharding-37" edge="1" parent="sharding-init" source="sharding-32" target="sharding-9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;strokeColor=#007FFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1384.5" y="820" /><mxPoint x="602.4" y="820" /></Array></mxGeometry></mxCell><mxCell id="sharding-info" parent="sharding-0" value="sharding-info" /><mxCell id="sharding-infobox" parent="sharding-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Clúster fragmentado&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Un &lt;b&gt;clúster fragmentado&lt;/b&gt; (sharded cluster) reparte los documentos de una colección entre varios servidores llamados &lt;b&gt;shards&lt;/b&gt;, para que ninguno tenga que guardar ni procesar todo. Aquí hay un router, un config server y dos shards, todos con MongoDB 8.2 y cada uno con su propio volumen. La colección &lt;i&gt;orders&lt;/i&gt; se reparte según su &lt;b&gt;shard key&lt;/b&gt;: el país y el cliente de cada orden.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Arranque&lt;/b&gt; (azul). &lt;b&gt;MongoShardingInit&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; inicia el config server y los dos shards (MongoDB exige que cada uno sea un replica set; aquí de un solo nodo), espera a que mongos responda y registra en él los dos shards. Si ya estaban registrados, no hace nada.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Uso&lt;/b&gt;. El &lt;b&gt;desarrollador&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; ejecuta las lecciones en &lt;b&gt;MongoShardingLab&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;, o se conecta desde el &lt;b&gt;host&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; con Compass o mongosh. En ambos casos habla solo con &lt;b&gt;mongos&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;, que para la aplicación se ve como una base de datos normal.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Enrutamiento&lt;/b&gt;. mongos no guarda datos. Lee del &lt;b&gt;config server&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; la tabla de &lt;b&gt;chunks&lt;/b&gt;, que dice qué rango de la shard key vive en qué shard, y la guarda en memoria. Si una operación incluye la shard key (o su prefijo, el país), la envía solo al shard dueño: &lt;b&gt;shard1&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt; o &lt;b&gt;shard2&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;. Si no la incluye, la envía a los dos, espera ambas respuestas y las une (scatter-gather). En una agregación, cada shard calcula su parte y mongos combina los resultados.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Balanceo&lt;/b&gt; (flechas punteadas). Al crear la colección, todo el rango de la shard key es un solo chunk en el primary shard, shard1 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;. El &lt;b&gt;balancer&lt;/b&gt;, que corre en el config server &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;, ve que shard1 tiene mucho más que shard2 &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;: corta el rango y mueve chunks de uno a otro. Primero copia los documentos al destino, luego actualiza la tabla de chunks y borra el origen. Desde ese momento mongos envía las operaciones de ese rango al nuevo dueño.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1540" y="40" width="700" height="470" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
